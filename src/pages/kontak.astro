---
import '../styles/pages/contact-page.css';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import {
	brandName,
	companyName,
	contactEmail,
	contactPhone,
	contactWhatsAppUrl,
	defaultKeywords,
	officeLocations,
} from '../data/site';
import Layout from '../layouts/Layout.astro';
import { absoluteUrl, buildBreadcrumbSchema } from '../lib/seo';

const contactTitle = `Kontak & Konsultasi IT | ${brandName}`;
const contactDescription = `Hubungi ${brandName} via WhatsApp ${contactPhone} atau email ${contactEmail}. Kantor di Lubuklinggau dan Bogor. Konsultasi solusi software, hardware, automasi, data analytics, dan AI.`;
const contactKeywords = [
	...defaultKeywords,
	'kontak technodigi',
	'konsultasi it whatsapp',
	'jasa it lubuklinggau',
	'jasa it bogor',
	'hubungi software house',
];

const contactTopics = [
	'Sistem Manajemen Digital',
	'Automation Systems',
	'Data Analytics',
	'Solusi Berbasis AI',
	'Support & Pengembangan Lanjutan',
];

const responseSteps = [
	{
		title: 'Ceritakan kebutuhan',
		summary: 'Bagikan konteks bisnis, kendala operasional, atau target digital yang ingin dicapai.',
	},
	{
		title: 'Kami petakan solusi',
		summary: 'Tim kami akan membantu merumuskan pendekatan teknologi, prioritas, dan langkah awal.',
	},
	{
		title: 'Mulai eksekusi',
		summary: 'Setelah ruang lingkup jelas, proyek dapat dilanjutkan ke desain, implementasi, dan support.',
	},
];

const breadcrumbSchema = buildBreadcrumbSchema(
	[
		{ name: 'Beranda', path: '/' },
		{ name: 'Kontak', path: '/kontak' },
	],
	'/kontak#breadcrumb',
);

const contactPageSchema = {
	'@type': 'ContactPage',
	'@id': absoluteUrl('/kontak#contact-page'),
	name: contactTitle,
	description: contactDescription,
	url: absoluteUrl('/kontak'),
	mainEntity: {
		'@id': absoluteUrl('#organization'),
	},
};
---

<Layout
	title={contactTitle}
	description={contactDescription}
	keywords={contactKeywords}
	canonical="/kontak"
	pageType="ContactPage"
	structuredData={[breadcrumbSchema, contactPageSchema]}
>
	<div class="page-shell">
		<SiteHeader active="contact" />

		<main id="main-content">
			<section class="contact-hero" aria-labelledby="contact-hero-title">
				<div class="contact-hero-media" aria-hidden="true">
					<img
						src="/images/it-hero.png"
						alt="Hubungi Technodigi untuk konsultasi software, hardware, dan layanan IT"
						width="1672"
						height="941"
						fetchpriority="high"
					/>
				</div>

				<div class="container contact-hero-inner">
					<div class="contact-hero-copy">
						<p class="section-kicker">Kontak</p>
						<h1 id="contact-hero-title">Diskusikan kebutuhan digital Anda bersama Technodigi.</h1>
						<p>
							Kami siap membantu memetakan solusi digital, automasi, data analytics, AI, dan
							pengembangan sistem yang sesuai dengan kebutuhan bisnis Anda.
						</p>

						<div class="contact-actions" aria-label="Aksi kontak utama">
							<a
								class="button button-primary"
								href={contactWhatsAppUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Chat WhatsApp
								<svg aria-hidden="true" viewBox="0 0 24 24">
									<path d="M5 12h14" />
									<path d="m13 6 6 6-6 6" />
								</svg>
							</a>
							<a class="button button-secondary" href={`mailto:${contactEmail}`}>Kirim Email</a>
						</div>
					</div>

					<aside class="contact-panel" aria-label="Informasi kontak Technodigi">
						<a
							class="contact-method"
							href={contactWhatsAppUrl}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`Chat WhatsApp Technodigi di nomor ${contactPhone}`}
						>
							<span>WhatsApp</span>
							<strong>{contactPhone}</strong>
							<small>Buka chat WhatsApp</small>
						</a>

						<a class="contact-method" href={`mailto:${contactEmail}`}>
							<span>Email</span>
							<strong>{contactEmail}</strong>
							<small>Kirim email ke Technodigi</small>
						</a>

						<div class="contact-method contact-method-locations">
							<span>Lokasi</span>
							<ul class="location-list">
								{
									officeLocations.map((office) => (
										<li>
											<strong>{office.label}</strong>
											<small>{office.region}</small>
										</li>
									))
								}
							</ul>
							<small class="location-note">Melayani kebutuhan transformasi digital di Indonesia.</small>
						</div>
					</aside>
				</div>
			</section>

			<section class="contact-section contact-light" aria-labelledby="contact-topics-title">
				<div class="container contact-topic-layout">
					<div>
						<p class="section-kicker">Topik Konsultasi</p>
						<h2 id="contact-topics-title">Mulai dari kebutuhan paling mendesak.</h2>
						<p>
							Bila belum punya brief lengkap, cukup kirim gambaran masalah atau target bisnisnya.
							Kami bantu susun langkah teknis yang lebih jelas.
						</p>
					</div>

					<div class="topic-grid" aria-label="Daftar topik konsultasi">
						{contactTopics.map((topic) => <span>{topic}</span>)}
					</div>
				</div>
			</section>

			<section class="contact-section contact-muted" aria-labelledby="response-title">
				<div class="container response-layout">
					<div>
						<p class="section-kicker">Alur Diskusi</p>
						<h2 id="response-title">Dari obrolan awal ke rencana implementasi.</h2>
					</div>

					<div class="response-list">
						{responseSteps.map((step, index) => (
							<article>
								<span>{String(index + 1).padStart(2, '0')}</span>
								<div>
									<h3>{step.title}</h3>
									<p>{step.summary}</p>
								</div>
							</article>
						))}
					</div>
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>
