---
import '../styles/pages/product-page.css';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import ProductFilter from '../components/product/ProductFilter.astro';
import { companyName, products } from '../data/site';
import Layout from '../layouts/Layout.astro';

const productTitle = `Produk dan Layanan IT | ${companyName}`;
const productDescription = `${companyName} menyediakan produk software, hardware, dan konsultan IT dengan filter kategori untuk menemukan solusi yang sesuai kebutuhan bisnis.`;
const serviceItemListSchema = {
	'@type': 'ItemList',
	'@id': 'https://technodigi.id/produk#services',
	name: 'Produk dan Layanan IT Technodigi',
	itemListElement: products.map((product, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		item: {
			'@type': 'Service',
			'@id': `https://technodigi.id/produk#${product.id}`,
			name: product.title,
			description: product.description,
			serviceType: product.category,
			provider: {
				'@id': 'https://technodigi.id/#organization',
			},
			areaServed: 'Indonesia',
		},
	})),
};
const breadcrumbSchema = {
	'@type': 'BreadcrumbList',
	'@id': 'https://technodigi.id/produk#breadcrumb',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Beranda',
			item: 'https://technodigi.id/',
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Produk',
			item: 'https://technodigi.id/produk',
		},
	],
};
---

<Layout
	title={productTitle}
	description={productDescription}
	canonical="/produk"
	structuredData={[serviceItemListSchema, breadcrumbSchema]}
>
	<div class="page-shell">
		<SiteHeader active="products" />

		<main>
			<section class="product-hero" aria-labelledby="product-hero-title">
				<div class="container product-hero-inner">
					<div>
						<p class="section-kicker">Produk Technodigi</p>
						<h1 id="product-hero-title">Software, hardware, dan konsultan IT dalam satu ekosistem.</h1>
						<p>
							Pilih kategori layanan yang paling dekat dengan kebutuhan Anda. Setiap produk dapat
							disesuaikan untuk proyek baru, perbaikan sistem berjalan, atau transformasi digital
							bertahap.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href="#daftar-produk">
								Jelajahi Produk
								<svg aria-hidden="true" viewBox="0 0 24 24">
									<path d="M5 12h14" />
									<path d="m13 6 6 6-6 6" />
								</svg>
							</a>
							<a class="button button-secondary" href="/kontak">Diskusi Kebutuhan</a>
						</div>
					</div>

					<div class="hero-panel" aria-label="Ringkasan produk">
						<span>{products.length}</span>
						<p>produk dan layanan siap dikurasi sesuai kebutuhan bisnis Anda.</p>
					</div>
				</div>
			</section>

			<section class="product-section" id="daftar-produk">
				<div class="container">
					<ProductFilter />
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>
