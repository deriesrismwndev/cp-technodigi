---
import '../styles/pages/product-page.css';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import ProductFilter from '../components/product/ProductFilter.astro';
import { brandName, defaultKeywords, products } from '../data/site';
import Layout from '../layouts/Layout.astro';
import { absoluteUrl, buildBreadcrumbSchema } from '../lib/seo';

const productTitle = `Produk & Layanan Software, Hardware, IT | ${brandName}`;
const productDescription = `Temukan ${products.length}+ layanan ${brandName}: aplikasi custom, dashboard BI, integrasi API, server & jaringan, audit IT, dan roadmap transformasi digital untuk bisnis Indonesia.`;
const productKeywords = [
	...defaultKeywords,
	'produk software perusahaan',
	'layanan hardware kantor',
	'jasa audit it',
	'roadmap transformasi digital',
	'dashboard business intelligence',
];

const serviceItemListSchema = {
	'@type': 'ItemList',
	'@id': absoluteUrl('/produk#services'),
	name: `Produk dan Layanan IT ${brandName}`,
	numberOfItems: products.length,
	itemListElement: products.map((product, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		item: {
			'@type': 'Service',
			'@id': absoluteUrl(`/produk#${product.id}`),
			name: product.title,
			description: product.description,
			serviceType: product.category,
			provider: {
				'@id': absoluteUrl('#organization'),
			},
			areaServed: 'Indonesia',
		},
	})),
};

const breadcrumbSchema = buildBreadcrumbSchema(
	[
		{ name: 'Beranda', path: '/' },
		{ name: 'Produk', path: '/produk' },
	],
	'/produk#breadcrumb',
);
---

<Layout
	title={productTitle}
	description={productDescription}
	keywords={productKeywords}
	canonical="/produk"
	pageType="CollectionPage"
	structuredData={[serviceItemListSchema, breadcrumbSchema]}
>
	<div class="page-shell">
		<SiteHeader active="products" />

		<main id="main-content">
			<section class="product-hero" aria-labelledby="product-hero-title">
				<div class="container product-hero-inner">
					<div>
						<p class="section-kicker">Produk Technodigi</p>
						<h1 id="product-hero-title">Software, hardware, dan konsultan IT dalam satu ekosistem.</h1>
						<p>
							Pilih kategori layanan yang paling dekat dengan kebutuhan Anda. Setiap produk dapat
							disesuaikan untuk proyek baru, perbaikan sistem berjalan, atau transformasi digital
							bertahap.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href="#daftar-produk">
								Jelajahi Produk
								<svg aria-hidden="true" viewBox="0 0 24 24">
									<path d="M5 12h14" />
									<path d="m13 6 6 6-6 6" />
								</svg>
							</a>
							<a class="button button-secondary" href="/kontak">Diskusi Kebutuhan</a>
						</div>
					</div>

					<div class="hero-panel" aria-label="Ringkasan produk">
						<span>{products.length}</span>
						<p>produk dan layanan siap dikurasi sesuai kebutuhan bisnis Anda.</p>
					</div>
				</div>
			</section>

			<section class="product-section" id="daftar-produk" aria-label="Daftar produk dan layanan">
				<div class="container">
					<ProductFilter />
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>
