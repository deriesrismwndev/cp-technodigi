---
import '../styles/pages/home.css';
import {
	companyName,
	contactWhatsAppUrl,
	faqItems,
	serviceCategories,
	valueItems,
} from '../data/site';
---

<main id="main-content">
	<section class="hero" id="beranda" aria-labelledby="hero-title">
		<div class="hero-media" aria-hidden="true">
			<img
				src="/images/it-hero.png"
				alt="Solusi software, hardware, dan konsultan IT Technodigi untuk transformasi digital bisnis"
				width="1672"
				height="941"
				fetchpriority="high"
			/>
		</div>

		<div class="hero-content">
			<p class="eyebrow">Software | AI | Data Analytics | IT Support</p>
			<h1 id="hero-title">Bangun sistem digital yang membantu bisnis Anda bergerak lebih cepat.</h1>
			<p class="hero-copy">
				{companyName} membantu perusahaan memetakan kebutuhan teknologi, membangun solusi yang tepat,
				dan menjaga operasi tetap aman saat bisnis tumbuh.
			</p>
			<div class="hero-actions" aria-label="Aksi utama">
				<a
					class="button button-primary"
					href={contactWhatsAppUrl}
					target="_blank"
					rel="noopener noreferrer"
				>
					Konsultasi Gratis
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<path d="M5 12h14" />
						<path d="m13 6 6 6-6 6" />
					</svg>
				</a>
				<a class="button button-secondary" href="/layanan">Lihat Layanan Kami</a>
			</div>
			<div class="hero-highlights" aria-label="Keunggulan layanan">
				<div class="hero-highlight">Solusi yang disesuaikan dengan proses bisnis</div>
				<div class="hero-highlight">Dari audit, desain, hingga implementasi</div>
				<div class="hero-highlight">Dukungan teknis terpercaya</div>
			</div>
		</div>
	</section>

	<section class="section section-light" id="tentang-kami" aria-labelledby="about-title">
		<div class="container about-grid">
			<div>
				<p class="section-kicker">Tentang Kami</p>
				<h2 id="about-title">Kami membantu bisnis mengubah kebutuhan jadi sistem yang jelas, cepat, dan siap berkembang.</h2>
			</div>
			<div class="about-copy">
				<p>
					{companyName} membantu organisasi menjawab tantangan transformasi digital melalui
					sistem manajemen digital, automasi, data analytics, dan solusi berbasis AI.
				</p>
				<p>
					Setiap solusi dirancang agar efektif, efisien, adaptif, dan dapat berkembang mengikuti
					kebutuhan bisnis tanpa mengorbankan stabilitas.
				</p>
				<a class="button button-primary about-link" href="/tentang-kami">
					Selengkapnya
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<path d="M5 12h14" />
						<path d="m13 6 6 6-6 6" />
					</svg>
				</a>
			</div>
		</div>

		<div class="container value-grid" aria-label="Keunggulan TechnoDigi">
			{
				valueItems.map((item) => (
					<div class="value-item">
						<span>{item.number}</span>
						<h3>{item.title}</h3>
						<p>{item.summary}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section section-muted" id="layanan" aria-labelledby="services-title">
		<div class="container section-heading">
			<p class="section-kicker">Layanan Utama</p>
			<h2 id="services-title">4 Ekosistem Layanan Solusi Digital & IT Technodigi</h2>
			<p>
				Dapat disesuaikan untuk pengembangan proyek baru, otomatisasi alur kerja, pengolahan data,
				maupun pengadaan & pemeliharaan infrastruktur teknologi perusahaan.
			</p>
		</div>

		<div class="container home-services-grid">
			{
				serviceCategories.map((service) => (
					<article class="home-service-card">
						<div class="home-service-card-top">
							<span class="home-service-badge">{service.badge}</span>
							<h3>
								<a href={`/layanan/${service.slug}`}>{service.title}</a>
							</h3>
							<p>{service.description}</p>

							<div class="home-service-chips">
								{service.subServices.map((sub) => (
									<span class="home-service-chip">{sub.title}</span>
								))}
							</div>
						</div>

						<div>
							<a
								class="button button-primary"
								style="width: 100%; justify-content: center; font-size: 0.9rem;"
								href={`/layanan/${service.slug}`}
							>
								Lihat Detail Layanan
								<svg aria-hidden="true" viewBox="0 0 24 24">
									<path d="M5 12h14" />
									<path d="m13 6 6 6-6 6" />
								</svg>
							</a>
						</div>
					</article>
				))
			}
		</div>

		<div class="container" style="text-align: center; margin-top: 40px;">
			<a class="button button-secondary" href="/layanan">
				Jelajahi Semua Katalog Layanan
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<path d="M5 12h14" />
					<path d="m13 6 6 6-6 6" />
				</svg>
			</a>
		</div>
	</section>

	<section class="section contact-section" id="partner" aria-labelledby="partner-title">
		<div class="container contact-grid">
			<div class="contact-copy partner-copy">
				<p class="section-kicker">Partner & Client</p>

				<h2 id="partner-title">Dipercaya berbagai partner dan client.</h2>

				<p>
					{companyName} menghadirkan solusi teknologi modern untuk berbagai perusahaan dan
					institusi.
				</p>
			</div>

			<div class="client-slider">
				<div class="client-track">
					<img
						class="client-logo"
						src="/images/client/logo_kerjasama.png"
						alt="Logo partner Kerja Sama"
						width="2022"
						height="1843"
						loading="lazy"
					/>
					<img
						class="client-logo"
						src="/images/client/logo_palembang.png"
						alt="Logo partner Palembang"
						width="473"
						height="600"
						loading="lazy"
					/>
					<div class="coming-soon">Coming Soon</div>
					<div class="coming-soon">Coming Soon</div>
					<div class="coming-soon">Coming Soon</div>

					<img
						class="client-logo"
						src="/images/client/logo_kerjasama.png"
						alt=""
						width="2022"
						height="1843"
						loading="lazy"
						aria-hidden="true"
					/>
					<img
						class="client-logo"
						src="/images/client/logo_palembang.png"
						alt=""
						width="473"
						height="600"
						loading="lazy"
						aria-hidden="true"
					/>
					<div class="coming-soon">Coming Soon</div>
					<div class="coming-soon">Coming Soon</div>
					<div class="coming-soon">Coming Soon</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section section-light faq-section" id="faq" aria-labelledby="faq-title">
		<div class="container section-heading">
			<p class="section-kicker">FAQ</p>
			<h2 id="faq-title">Pertanyaan yang sering diajukan.</h2>
			<p>Jawaban singkat sebelum Anda memulai konsultasi dengan tim Technodigi.</p>
		</div>

		<div class="container faq-list">
			{
				faqItems.map((item) => (
					<details class="faq-item">
						<summary><h3>{item.question}</h3></summary>
						<p>{item.answer}</p>
					</details>
				))
			}
		</div>
	</section>
</main>
