---
import '../../styles/components/product-card.css';
import { productCategories, type ProductItem, type ProductCategory } from '../../data/site';

interface Props {
	product: ProductItem;
	variant?: 'compact' | 'detailed';
}

const { product, variant = 'detailed' } = Astro.props;
const category = productCategories.find((item) => item.value === product.category);

const iconPaths: Record<ProductCategory, string[]> = {
	software: [
		'M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v8a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 14.5v-8Z',
		'M8 20h8',
		'M12 17v3',
		'M8.5 9.5 10.5 11.5 8.5 13.5',
		'M15.5 9.5 13.5 13.5',
	],
	hardware: [
		'M6 4h12a2 2 0 0 1 2 2v5H4V6a2 2 0 0 1 2-2Z',
		'M4 11h16v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-7Z',
		'M8 15h.01',
		'M12 15h4',
		'M8 7h8',
	],
	consulting: [
		'M8 8a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z',
		'M5 21a7 7 0 0 1 14 0',
		'M18 5.5h2',
		'M19 4.5v2',
		'M4 5.5h2',
		'M5 4.5v2',
	],
};
---

<article
	class:list={['product-card', `product-card-${variant}`]}
	data-product-card
	data-category={product.category}
	id={product.id}
>
	<div class="product-card-head">
		<div class="product-icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none">
				{iconPaths[product.category].map((path) => <path d={path} />)}
			</svg>
		</div>
		<span>{category?.label}</span>
	</div>

	<h3>{product.title}</h3>
	<p>{variant === 'detailed' ? product.description : product.summary}</p>

	<ul class="feature-list">
		{product.features.map((feature) => <li>{feature}</li>)}
	</ul>

	{
		variant === 'detailed' && (
			<div class="tag-list" aria-label={`Teknologi dan cakupan ${product.title}`}>
				{product.tags.map((tag) => (
					<span>{tag}</span>
				))}
			</div>
		)
	}
</article>
