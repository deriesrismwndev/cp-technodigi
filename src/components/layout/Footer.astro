---
const currentYear = new Date().getFullYear();

const footerLinks = {
  navigation: [
    { href: "/", label: "Home" },
    { href: "/about", label: "About" },
    { href: "/services", label: "Services" },
    { href: "/contact", label: "Contact" },
  ],
  services: [
    { href: "/services", label: "Software Development" },
    { href: "/services", label: "Business Automation & AI" },
    { href: "/services", label: "Data Analytics" },
    { href: "/services", label: "IT Infrastructure & Support" },
  ],
};
---

<footer class="relative border-t border-white/10 bg-transparent pt-16 pb-12 font-sans">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    
    <div class="lg:hidden flex flex-col items-center justify-center text-center space-y-7">
      <div class="flex flex-col items-center justify-center">
        <a href="/" class="inline-flex items-center group">
          <img
            src="/images/logo.png"
            alt="Technodigi Mandiri Solusi"
            width={48}
            height={48}
            class="h-12 w-12 transition-transform duration-300 group-hover:scale-105"
            style={{
              filter:
                "brightness(0) invert(1) sepia(1) saturate(6) hue-rotate(134deg) brightness(0.9)",
            }}
          />
        </a>
        <h3 class="font-bold bg-gradient-to-r from-white via-[#a5f3fc] to-[#22b4a6] bg-clip-text text-transparent text-base font-sans mt-3">
          Technodigi Mandiri Solusi
        </h3>
      </div>

      <p class="font-sans text-sm text-[#a3a3a3] max-w-md leading-relaxed -mt-2">
        Mitra teknologi terpercaya Anda untuk transformasi digital, otomatisasi, dan pengembangan sistem terintegrasi.
      </p>

      <div class="space-y-1.5 font-sans text-sm text-[#a3a3a3]">
        <div>
          <a href="mailto:support@technodigi.co.id" class="hover:text-[#22b4a6] transition-colors">
            support@technodigi.co.id
          </a>
        </div>
        <div>
          <a href="https://wa.me/6285353615220" class="hover:text-[#22b4a6] transition-colors">
            +62 853-5361-5220
          </a>
        </div>
      </div>

      <div class="font-mono text-xs text-[#a3a3a3] space-y-1">
        <div>Bogor, Jawa Barat, Indonesia</div>
        <div>Lubuklinggau, Sumatera Selatan, Indonesia</div>
      </div>

      <div class="flex items-center justify-center gap-4 pt-1">
        <a
          href="https://www.instagram.com/technodigi.co.id"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 rounded-2xl bg-white/[0.04] border border-white/10 text-[#a3a3a3] hover:text-[#22b4a6] hover:border-[#22b4a6]/40 hover:bg-[#22b4a6]/10 transition-all"
          aria-label="Instagram"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/company/technodigi-id"
