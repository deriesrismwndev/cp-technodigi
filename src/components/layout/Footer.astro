          class="p-3 rounded-2xl bg-white/[0.04] border border-white/10 text-[#a3a3a3] hover:text-[#22b4a6] hover:border-[#22b4a6]/40 hover:bg-[#22b4a6]/10 transition-all"
          aria-label="LinkedIn"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
        </a>
      </div>

      <div class="flex items-center justify-center gap-6 font-sans text-xs text-[#a3a3a3] pt-1">
        <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a>
        <span class="text-white/20">•</span>
        <a href="/terms-of-service" class="hover:text-white transition-colors">Terms & Conditions</a>
      </div>

      <div class="font-sans text-xs text-[#737373]">
        &copy; {currentYear} Technodigi Mandiri Solusi. All rights reserved.
      </div>
    </div>

    <div class="hidden lg:grid grid-cols-12 gap-8">
      <div class="col-span-4">
        <a href="/" class="inline-flex items-center group">
          <img
            src="/images/logo.png"
            alt="Technodigi Mandiri Solusi"
            width={48}
            height={48}
            class="h-12 w-12 transition-transform duration-300 group-hover:scale-105"
            style={{
              filter:
                "brightness(0) invert(1) sepia(1) saturate(6) hue-rotate(134deg) brightness(0.9)",
