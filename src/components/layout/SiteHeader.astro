---
import '../../styles/components/layout.css';
import {
	contactEmail,
	contactPhone,
	contactWhatsAppUrl,
	navItems,
	type NavKey,
} from '../../data/site';

interface Props {
	active?: NavKey;
}

const { active = 'home' } = Astro.props;
---

<header class="site-header" data-site-header>
	<div class="container header-inner">
		<a class="brand" href="/" aria-label="Technodigi beranda">
			<img src="/images/technodigi_logo.svg" alt="TechnoDigi" width="2480" height="1906" />
		</a>

		<button
			class="nav-toggle"
			type="button"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="site-nav-panel"
			aria-label="Buka menu navigasi"
		>
			<span class="nav-toggle-box" aria-hidden="true">
				<span class="nav-toggle-bar"></span>
				<span class="nav-toggle-bar"></span>
				<span class="nav-toggle-bar"></span>
			</span>
		</button>

		<nav class="site-nav site-nav-desktop" aria-label="Menu utama">
			{
				navItems.map((item) => (
					<a href={item.href} aria-current={active === item.key ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>

		<button
			class="header-action header-action-desktop"
			type="button"
			data-consultation-trigger
			aria-haspopup="dialog"
			aria-controls="consultation-dialog"
		>
			Konsultasi
		</button>
	</div>

	<div class="header-nav-panel" id="site-nav-panel" data-nav-panel hidden>
		<div class="container header-nav-panel-inner">
			<nav class="site-nav site-nav-mobile" aria-label="Menu utama">
				{
					navItems.map((item) => (
						<a href={item.href} aria-current={active === item.key ? 'page' : undefined}>
							{item.label}
						</a>
					))
				}
			</nav>

			<button
				class="header-action header-action-mobile"
				type="button"
				data-consultation-trigger
				aria-haspopup="dialog"
				aria-controls="consultation-dialog"
			>
				Konsultasi
			</button>
		</div>
	</div>
</header>

<dialog class="consultation-modal" id="consultation-dialog" data-consultation-dialog>
	<div class="consultation-modal-inner">
		<div class="consultation-modal-head">
			<div>
				<p>Pilih Kanal</p>
				<h2>Konsultasi Technodigi</h2>
			</div>
			<button class="modal-close" type="button" data-consultation-close aria-label="Tutup modal">
				<span aria-hidden="true">&times;</span>
			</button>
		</div>

		<div class="consultation-options" aria-label="Pilihan kanal konsultasi">
			<a
				class="consultation-option"
				href={contactWhatsAppUrl}
				target="_blank"
				rel="noopener noreferrer"
				data-consultation-link
			>
				<span>WhatsApp</span>
				<strong>{contactPhone}</strong>
				<small>Chat langsung di tab baru</small>
			</a>

			<a
				class="consultation-option"
				href={`mailto:${contactEmail}`}
				target="_blank"
				rel="noopener noreferrer"
				data-consultation-link
			>
				<span>Email</span>
				<strong>{contactEmail}</strong>
				<small>Buka email di tab baru</small>
			</a>
		</div>
	</div>
</dialog>

<script>
	const setupMobileNav = () => {
		const header = document.querySelector('[data-site-header]');
		const toggle = document.querySelector('[data-nav-toggle]');
		const panel = document.querySelector('[data-nav-panel]');

		if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;
		if (!(panel instanceof HTMLElement)) return;
		if (toggle.dataset.bound === 'true') return;

		toggle.dataset.bound = 'true';

		const closeNav = () => {
			header.removeAttribute('data-nav-open');
			panel.hidden = true;
			toggle.setAttribute('aria-expanded', 'false');
			toggle.setAttribute('aria-label', 'Buka menu navigasi');
			document.body.style.removeProperty('overflow');
		};

		const openNav = () => {
			header.setAttribute('data-nav-open', '');
			panel.hidden = false;
			toggle.setAttribute('aria-expanded', 'true');
			toggle.setAttribute('aria-label', 'Tutup menu navigasi');
			document.body.style.overflow = 'hidden';
		};

		toggle.addEventListener('click', () => {
			if (header.hasAttribute('data-nav-open')) closeNav();
			else openNav();
		});

		panel.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', closeNav);
		});

		panel.querySelectorAll('[data-consultation-trigger]').forEach((button) => {
			button.addEventListener('click', closeNav);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && header.hasAttribute('data-nav-open')) closeNav();
		});

		window.addEventListener('resize', () => {
			if (window.innerWidth > 940) closeNav();
		});
	};

	const setupConsultationModal = () => {
		const triggers = document.querySelectorAll('[data-consultation-trigger]');
		const dialog = document.querySelector('[data-consultation-dialog]');

		if (!(dialog instanceof HTMLDialogElement) || triggers.length === 0) return;

		triggers.forEach((trigger) => {
			if (!(trigger instanceof HTMLButtonElement)) return;
			if (trigger.dataset.bound === 'true') return;

			trigger.dataset.bound = 'true';

			trigger.addEventListener('click', () => {
				if (!dialog.open) dialog.showModal();
			});
		});

		dialog.querySelectorAll('[data-consultation-close]').forEach((button) => {
			if (button instanceof HTMLButtonElement && button.dataset.bound !== 'true') {
				button.dataset.bound = 'true';
				button.addEventListener('click', () => dialog.close());
			}
		});

		dialog.querySelectorAll('[data-consultation-link]').forEach((link) => {
			if (link instanceof HTMLAnchorElement && link.dataset.bound !== 'true') {
				link.dataset.bound = 'true';
				link.addEventListener('click', () => dialog.close());
			}
		});

		if (dialog.dataset.bound !== 'true') {
			dialog.dataset.bound = 'true';
			dialog.addEventListener('click', (event) => {
				if (event.target === dialog) dialog.close();
			});
		}
	};

	setupMobileNav();
	setupConsultationModal();
	document.addEventListener('astro:page-load', () => {
		setupMobileNav();
		setupConsultationModal();
	});
</script>
